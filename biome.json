{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "plugins": [
    "./biome-plugins/no-nullish-coalescing.grit",
    "./biome-plugins/no-or-fallback.grit",
    "./biome-plugins/no-type-assertion.grit",
    "./biome-plugins/prefer-z-uuid.grit",
    "./biome-plugins/prefer-z-url.grit",
    "./biome-plugins/prefer-z-nonempty.grit",
    "./biome-plugins/prefer-z-safe-parse.grit",
    "./biome-plugins/no-bare-z-string.grit",
    "./biome-plugins/no-tri-state-z-boolean.grit",
    "./biome-plugins/no-tri-state-z-array.grit",
    "./biome-plugins/no-new-date.grit",
    "./biome-plugins/no-while-loop.grit",
    "./biome-plugins/no-let.grit"
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "src/**/*.{ts,tsx}",
      "__tests__/**/*.{ts,tsx}",
      "vite.config.mts",
      "!src/generated",
      "!src/components/ui/**/*.{ts,tsx}",
      "!**/node_modules",
      "!**/dist"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {},
      "a11y": {},
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "warn",
            "noSvgWithoutTitle": "warn",
            "useKeyWithClickEvents": "warn",
            "noLabelWithoutControl": "warn",
            "noNoninteractiveTabindex": "warn",
            "useButtonType": "warn"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "includes": ["**"],
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}

node_modules
.env
.env.*
!.env.example

# Local dev secrets in the wrangler/Cloudflare convention. Same class as
# .env — holds live credentials — but it was never ignored, so it showed
# up as an untracked file that any `git add -A` (or an automated commit
# hook) would happily stage.
.dev.vars
.dev.vars.*

log.txt
.idea
dist
coverage
.DS_Store
tsconfig.tsbuildinfo
tsconfig.*.tsbuildinfo

# Documentation build output
docs/build
docs/.docusaurus

# Package manager caches
.pnpm-store/

# Prisma client is generated locally via `bun run db:generate`
src/generated

# tsc emits next to the .ts source when scripts/tsconfig is invoked directly
scripts/*.js
scripts/*.js.map
scripts/*.d.ts

# Personal Claude Code overrides — settings.local.json lives outside the team
# settings.json so individual permission tweaks stay out of git.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Python bytecode cache
__pycache__/

# mitmproxy capture output (sessions + JSON pairs)
captures/

# Local self-host runtime state: compose.yaml bind-mounts the config
# envelope here, including the minted APIKEY, rotating backups and logs.
# Never commit it (already excluded from the image via .dockerignore).
rialto-config/
# Pre-rename name of the same host directory.
ccr-config/

# Local subscription credential mirrors fed to the dev server. Both
# directories hold OAuth tokens / IDE configs and must never be committed.
rialto-auth/
ccr-auth/
.codex/

# Artifacts dropped at the repo root by browser MCP tools (Playwright /
# chrome-devtools save into the cwd). Never commit these.
/*.png
.playwright-mcp/
screenshots/
logs/

# UI mock tooling: screenshots + diffs are regenerated by `bun run mocks:shoot`
# and `mocks:diff`; the compiled mock stylesheet by `mocks:css`.
mocks/.shots/
mocks/_shared/mock.build.css

# Local Codex configuration, credentials, and session state.
/.codex/

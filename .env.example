# Copy to .env and fill in. The .env file is gitignored.
#
# Provider keys (used by tests and the local config you import into the DB).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Postgres connection used by the server to load Providers / Router / etc.
# The DB is brought up by .devcontainer/compose.yaml — `postgres` resolves
# inside the devcontainer's docker network. host.docker.internal:5432 works
# too if you prefer the host-facing name.
DATABASE_URL=postgres://postgres:password@postgres:5432/ccr

# Separate database used by `bun test`. The test preload routes
# DATABASE_URL through this value (and refuses to run if unset, equal
# to DATABASE_URL, or pointing at a DB whose name doesn't contain
# "test"). The ccr_test DB is created by postgres-initdb.d on fresh
# volumes; on an existing volume run `createdb -U postgres ccr_test`
# once and then `bun run db:migrate:test`.
TEST_DATABASE_URL=postgres://postgres:password@postgres:5432/ccr_test

# Redis (BullMQ) for the recurring usage-capture job. Brought up by
# .devcontainer/compose.yaml — `redis` resolves on the devcontainer
# network. The server still serves if Redis is down; usage history
# just won't update until it's reachable.
REDIS_URL=redis://redis:6379

# Required: encryption key for SubAccount token-at-rest.
# 32-byte base64 or 64-char hex recommended.
CCR_ACCOUNT_ENCRYPTION_KEY=

# Optional: directories holding the subscription credential files.
# The server reads exactly one file per vendor in each directory:
#   Claude: <CCR_CLAUDE_CREDENTIALS_DIR>/.credentials.json
#   Codex:  <CCR_CODEX_AUTH_DIR>/auth.json
# Each file may be a single account object (the default CLI layout) or
# an array of account objects to register multiple subscriptions at
# once. When DIR is unset the server falls back to the CLI defaults
# (~/.claude/.credentials.json and ~/.codex/auth.json).
CCR_CLAUDE_CREDENTIALS_DIR=/home/vscode/app/ccr-auth
CCR_CODEX_AUTH_DIR=/home/vscode/app/ccr-auth

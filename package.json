{
  "name": "rialto",
  "version": "2.83.0",
  "description": "Use Claude Code without an Anthropics account and route it to another LLM provider",
  "scripts": {
    "dev": "vite --host --port 16175",
    "build": "vite build",
    "release": "bun run build && bash scripts/release.sh docker",
    "release:docker": "bash scripts/release.sh docker",
    "dev:ui": "vite",
    "pwa:icons": "bun run scripts/build-pwa-icons.ts",
    "mocks:css": "bun run scripts/build-mock-css.ts",
    "mocks:serve": "bun run scripts/serve-mocks.ts",
    "mocks:shoot": "bun run .claude/skills/ui-mock-diff/scripts/shoot.ts",
    "mocks:diff": "bun run .claude/skills/ui-mock-diff/scripts/diff.ts",
    "test": "bun test __tests__/lib __tests__/db __tests__/preset",
    "test:coverage": "bun test --coverage __tests__/lib __tests__/db __tests__/preset",
    "test:providers": "bun test __tests__/providers",
    "test:e2e": "bun test __tests__/e2e",
    "browser:install": "playwright install chromium",
    "db:migrate:test": "TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://postgres:password@postgres:5432/rialto_test}\" DATABASE_URL=\"$TEST_DATABASE_URL\" prisma migrate deploy",
    "scrape:openai-prices": "bun run scripts/scrape-openai-prices.ts",
    "scrape:anthropic-prices": "bun run scripts/scrape-anthropic-prices.ts",
    "scrape:google-prices": "bun run scripts/scrape-gemini-pricing.ts",
    "scrape:prices": "bun run scripts/scrape-all-prices.ts",
    "seed:prices-db": "bun run scripts/seed-prices-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:seed:demo": "bun run scripts/seed-demo-data.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "knip": "knip"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "llm",
    "anthropic"
  ],
  "author": "musistudio",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@openai/codex": "^0.152.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.35.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "overrides": {
    "@types/react": "18",
    "ioredis": "6.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",

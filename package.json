    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "openai": "^7.12.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "recharts": "3.10.1",
    "remixicon": "^4.9.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tiktoken": "^1.0.22",

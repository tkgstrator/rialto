// Rialto's Postgres-backed config store.
//
// The upstreams and how traffic is routed to them:
//   - Provider:                one row per LLM provider account (api_base_url + api_key)
//   - Model:                   one row per model name, child of Provider
//   - RouterPreferenceProfile: a named routing profile; `live` is the default every surface uses
//   - ProviderTierAlias:       which of a provider's models each tier (fable/opus/sonnet/haiku) is
//   - TierRoute:               a profile's tier map — per requested tier, the ordered provider·tiers
// Everything else here is the archive behind Activity and Overview, the
// subscription accounts and their observed quota, and issued credentials.
//
// Prisma 7: the datasource URL lives in prisma.config.ts (passed via a
// driver adapter), not in this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Outcome of the last real-inference connectivity test for a Model.
//   - unknown: never tested (or test reset)
//   - ok:      the vendor returned a successful minimal completion
//   - fail:    the vendor rejected the request / errored
enum ModelTestStatus {
  unknown
  ok
  fail
}

// Outcome of the last real auth probe for a SubAccount (token refresh +
// upstream profile/usage fetch). Distinct from expiresAt, which for
// Claude is an auto-refreshed access-token expiry and for Codex is the
// subscription end date — neither reliably signals "auth is dead".
//   - unknown: never probed (or reset)
//   - live:    the probe authenticated successfully
//   - invalid: the probe failed — the account needs re-authentication
enum AuthStatus {
  unknown
  live
  invalid
}

// How a Provider authenticates against its upstream API.
//   - api_key:      legacy mode; the stored apiKey is sent via Bearer / x-api-key.
//   - subscription: reuses Claude CLI's OAuth credentials at
//     ~/.claude/.credentials.json. The token never lands in the DB —
//     the server reads the file at request time.
enum AuthMode {
  api_key
  subscription
}

// Wire format of a Provider's chat endpoint, used to shape the
// connectivity test (and, later, the proxy). Always explicitly set per
// provider by the seed — there is no runtime fallback, so the value in
// the DB is authoritative. e.g. codex only speaks the OpenAI Responses
// API, not /chat/completions.
enum ApiStyle {
  openai_chat
  openai_responses
  anthropic
  gemini
}

model Provider {
  id                   String              @id @default(cuid())
  name                 String              @unique
  apiBaseUrl           String
  // Null means "unset" — the user hasn't supplied a key yet (fresh
  // seed) or has cleared it. An empty string is never stored; "no key"
  // is always NULL so the wire shape and UI stay consistent.
  apiKey               String?
  authMode             AuthMode            @default(api_key)
  // Request shape for this provider's chat endpoint. Seeded explicitly
  // for every provider; the default only covers a row created before
  // the seed runs.
  apiStyle             ApiStyle            @default(openai_chat)
  // Whether this provider is offered for routing at all. This used to be
  // `providerEnabled` inside a free-form `transformer` JSONB blob, which
  // meant the one question the scheduler asks most often could not be
  // filtered or indexed in SQL. The blob is gone: its other two tenants
  // were a derived view of `Model.enabled` (`_disabledModels`, rebuilt on
  // read and stripped before write, so never really stored) and the OAuth
  // credential the pipeline grafts on at request time (never persisted,
  // and a column would have written a live secret to disk).
  //
  // Defaults true because the blob's absence meant "enabled" — only an
  // explicit `providerEnabled: false` turned a provider off.
  enabled              Boolean             @default(true)
  // No account is designated. A subscription provider's accounts are all
  // candidates; which one serves a request is decided per request by
  // session-account-router, and "can this provider authenticate" is asked
  // of the accounts as a set (shared/subscription-credential.ts). The
  // dropped `activeSubscriptionAccountId` made both answers hostage to
  // one promoted row.
  subscriptionAccounts SubAccount[]        @relation("ProviderSubscriptionAccounts")
  models               Model[]
  tierAliases          ProviderTierAlias[]
  tierRoutes           TierRoute[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model SubAccount {
  id                 String     @id @default(cuid())
  providerId         String
  provider           Provider   @relation("ProviderSubscriptionAccounts", fields: [providerId], references: [id], onDelete: Cascade)
  sourcePath         String
  // User-facing on/off switch. Only enabled accounts are candidates for
  // the request-time picker, so a disabled row is ignored at request
  // time even though its tokens remain on disk.
  enabled            Boolean    @default(true)
  label              String
  userName           String?
  userEmail          String?
  userId             String?
  accountId          String?
  plan               String?
  rateLimitTier      String?
  // Expiry of the stored access token. Refreshed in place whenever the
  // grant rotates. Codex derives it from the token's own `exp` claim, so
  // a row written before this column meant that is self-correcting.
  expiresAt          DateTime?
  // When the paid subscription itself lapses — Codex only, read from the
  // id_token's `chatgpt_subscription_active_until`. Kept apart from
  // expiresAt: conflating them made every near-expiry refresh check
  // conclude an hour-long access token was good for months.
  subscriptionEndsAt DateTime?
  scopes             Json?
  // Encrypted token payloads. Plain tokens are never persisted.
  accessTokenEnc     String?
  refreshTokenEnc    String?
  idTokenEnc         String?
  // Monthly subscription price in USD, derived from the plan at sync
  // time (e.g. claude max → 100, codex pro → 200). Null when the plan
  // is unknown or free.
  monthlyPriceUsd    Float?
  // Last auth-probe outcome + timestamps. authCheckedAt is set on every
  // probe; authError holds the latest failure reason for display. The
  // periodic auth-health job and the manual profile sync both write these.
  authStatus         AuthStatus @default(unknown)
  authCheckedAt      DateTime?
  authError          String?
  lastSyncedAt       DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  usage SubAccountUsage[]
  quota SubAccountQuota?

  @@unique([providerId, sourcePath])
  @@index([providerId])
}

// Latest-state per-account rate-limit window snapshot. One row per
// (subAccountId, metric) pair, upserted by the usage poller every 5 min.
// Distinct from UsageSnapshot (time-series, aggregated across accounts)
// — this is the per-account current state the router consults to avoid
// 429s: an account is treated as exhausted on a window when
// `percent >= 100` and `resetAt` is still in the future.
model SubAccountUsage {
  id           String     @id @default(cuid())
  subAccountId String
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  // Window key — claude.five_hour, claude.seven_day,
  // claude.seven_day_sonnet, claude.seven_day_opus, codex.primary,
  // codex.secondary. Same metric format as UsageSnapshot.
  metric       String
  // 0-100 utilization at the most recent poll.
  percent      Float
  // Wall-clock time the window resets. Null means the upstream omitted
  // it (treat as unknown — never blocks routing).
  resetAt      DateTime?
  updatedAt    DateTime   @updatedAt

  @@unique([subAccountId, metric])
  @@index([subAccountId])
}

// Latest quota state per SubAccount, one row per account (upserted by
// the routing-scheduler collector). Horizontal layout so the scheduler
// reads a whole account's state in one row; SubAccountUsage (vertical,
// per-metric) stays as-is for its existing readers.
//
// Unit convention: this deployment's upstreams (Claude oauth/usage,
// Codex wham/usage) only report percentages, so `*Used` holds the
// observed utilization pct and `*Limit` is fixed at 100. If a future
// source reports absolute counts, the same columns hold counts and the
// ratio stays valid.
model SubAccountQuota {
  id           String     @id @default(cuid())
  subAccountId String     @unique
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  // 5h rolling window (claude.five_hour / codex.primary).
  fiveHourUsed          Float?
  fiveHourLimit         Float?
  fiveHourResetAt       DateTime?
  // Codex reports the actual window length on the wire; Claude is a
  // fixed 5h. Stored so drainTarget() never has to guess.
  fiveHourWindowSeconds Int?

  // Weekly window (claude.seven_day / codex.secondary).
  weeklyUsed          Float?
  weeklyLimit         Float?
  weeklyResetAt       DateTime?
  weeklyWindowSeconds Int?

  // Claude per-model weekly_scoped rows, keyed by scopedMetricKey slug:
  // { "fable": { "used": 42, "limit": 100, "resetAt": "..." }, ... }.
  // JSONB because the model set is dictated by the upstream response.
  scopedWindows Json?

  // Last observed rate-limit event on any model of this account,
  // written by the reactive 429 path (fire-and-forget).
  lastRateLimitedAt   DateTime?
  lastRateLimitStatus Int?
  // Parsed Retry-After (seconds) from the 429 response, when present.
  lastRetryAfterSec   Int?
  // Reserved for a future api_key path: subscription (OAuth) responses
  // do not carry rate-limit remaining headers, so these stay null in
  // Phase 1. Kept on the schema so the collector can start writing
  // them without another migration if upstream behaviour changes.
  headerRemaining     Float?
  headerResetAt       DateTime?

  // Banked rate-limit resets (Codex only), from wham/usage's
  // `rate_limit_reset_credits`. Available is what the account holds;
  // applicable is how many the vendor would accept now, which is 0 while
  // no window is spent. Null for Claude accounts and before first read.
  resetCreditsAvailable  Int?
  resetCreditsApplicable Int?

  // When the collector last completed a successful upstream refresh for
  // this account. Stale detection: now - quotaRefreshedAt > 3 * TTL_MS.
  quotaRefreshedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

model Model {
  id               String              @id @default(cuid())
  providerId       String
  provider         Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  // Whether this model is offered for routing / tested. Authoritative
  // (replaces the old provider.transformer._disabledModels list).
  // Defaults false: a model being registered/seeded does NOT make it
  // routable. Subscription presets seed their curated default set as
  // enabled; everything else stays off until the user enables it.
  enabled          Boolean             @default(false)
  // Per-model request-shape override. A single api_key provider (e.g.
  // openai) hosts both chat models and Responses-only models (codex
  // family), so the provider-level apiStyle isn't granular enough.
  // Null means "use the provider's apiStyle"; set explicitly (seeded)
  // for the models that need a different endpoint.
  apiStyle         ApiStyle?
  // Manual reasoning-effort override for OpenAI / OpenAI-Responses /
  // Codex models. Null = pass the request through untouched (vendor
  // default = 'medium'). Non-null values mirror the OpenAI OpenAPI
  // ReasoningEffort enum — 'none' | 'minimal' | 'low' | 'medium' |
  // 'high' | 'xhigh' | 'max' — and are injected into the outgoing
  // request's `reasoning_effort` (Chat Completions) or
  // `reasoning.effort` (Responses) at build time. Not every reasoning
  // model accepts every value; upstream 400s surface as request errors.
  reasoningEffort  String?
  // True when the vendor has marked this model as deprecated upstream.
  // The flag is seeded from src/shared/data/deprecations.ts at
  // boot and on the UI refresh-models action; we never delete the row
  // because the user may still be routing to it.
  deprecated       Boolean             @default(false)
  // True when the model sits under the vendor's "legacy" / older-gen
  // pricing surface (scraped `legacy` flag). Distinct from `deprecated`:
  // a model can be legacy-priced but not formally deprecated.
  legacy           Boolean             @default(false)
  // Official per-1M-token USD prices scraped from the vendor pricing
  // page (src/shared/data/providers/<vendor>/prices.json).
  // Null for subscription-auth models and any api_key model the scrape
  // didn't cover.
  inputPer1M       Float?
  outputPer1M      Float?
  // USD per 1M cached-input (cache-read) tokens, scraped alongside
  // input/output. Null when the vendor doesn't publish a cache rate.
  cachedInputPer1M Float?
  // Max context window in tokens, scraped from the vendor's model
  // pages alongside pricing. Null when the vendor doesn't publish it
  // (older Anthropic ids absent from the comparison table, Gemini
  // pending, subscription-only models).
  contextWindow    Int?
  // Last real-inference connectivity test outcome + timestamps.
  // testCheckedAt is set on every attempt; testPassedAt only on the
  // most recent success (kept even after a later failure so the UI can
  // show "last passed on ..."). testError holds the latest failure
  // reason for display.
  testStatus       ModelTestStatus     @default(unknown)
  testCheckedAt    DateTime?
  testPassedAt     DateTime?
  testError        String?
  tierAliases      ProviderTierAlias[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([providerId, name])
  @@index([providerId])
}

// A named routing profile. One row per profile holds the constraint knobs
// (exhaustedBehavior, quotaSkipPct, errorRateSkipPct, minHealthSamples);
// its tier map is TierRoute.
//
// `live` is the default profile every surface routes through until it
// is pointed at another one (InboundSurfaceConfig.profileKey), and a
// token may pin its client to a profile of its own (AccessToken.profileKey).
model RouterPreferenceProfile {
  id          String      @id @default(cuid())
  key         String      @unique @default("live")
  // Constraint knobs as JSONB (RoutingConstraintsSchema). JSONB so adding
  // a knob is not a migration; the schema layer supplies every default,
  // and keys an older build wrote are ignored rather than rejected.
  constraints Json?
  updatedAt   DateTime    @updatedAt
  tierRoutes  TierRoute[]
}

// "Which model is <tier> on this provider." Routing names a provider and a
// tier; this row says which model that is. When a vendor ships a new
// Sonnet, this is the one pointer that moves — every route that names
// the provider's sonnet follows it. It never moves by itself: a catalog
// refresh can only discover a model, and promoting it is an operator's
// decision (tier-alias-service.ts).
//
// Cascades both ways: deleting the model or the provider removes the
// alias, and a route that named it reads as unresolved rather than
// pointing at nothing.
model ProviderTierAlias {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // fable | opus | sonnet | haiku. Validated by Zod (ModelTierSchema), kept
  // a string like InboundSurfaceConfig.routingMode so a new model family
  // is a code change, not a migration.
  tier       String
  modelId    String
  model      Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  // When the alias was last pointed somewhere. A model of the same tier
  // created after this is a candidate an operator has not looked at yet.
  updatedAt  DateTime @updatedAt

  @@unique([providerId, tier])
  @@index([modelId])
}

// One route of a profile's tier map: a request for `requestedTier` may be
// served by `provider`'s `targetTier` model, in `priority` order (1 =
// first). Replaced the per-scenario, per-lane, per-model chain. A requested tier with no enabled routes is passed
// through as the caller sent it, the "no opinion" an empty lane meant.
model TierRoute {
  id            String                  @id @default(cuid())
  profileId     String
  profile       RouterPreferenceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // fable | opus | sonnet | haiku | other — the tier read off the model
  // name the caller sent, "other" when it names no Claude family.
  requestedTier String
  priority      Int
  providerId    String
  provider      Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // fable | opus | sonnet | haiku, resolved through the provider's alias.
  targetTier    String
  // Soft toggle: the route keeps its place while it is out of use.
  enabled       Boolean                 @default(true)

  @@unique([profileId, requestedTier, priority])
  // A provider's tier appears once per requested tier: a second copy
  // would resolve to the same model and could only ever be skipped.
  @@unique([profileId, requestedTier, providerId, targetTier])
  @@index([profileId])
  @@index([providerId])
}

// One row per client session. The id is the raw session token from
// the upstream client (Codex: thread_id, Claude Code: x-claude-session-id).
// Using the external ID as PK avoids a surrogate key round-trip on every
// request: the proxy can upsert by id without fetching first.
model Session {
  id          String       @id
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // Archive (soft-delete) marker. Non-null hides the session from the
  // History list, but its RequestLog rows stay so cost/usage totals are
  // preserved. Reset to null when the session receives new activity, so a
  // resumed session reappears in the list. Never physically deleted here.
  archivedAt  DateTime?
  // First-observed inbound wire type for this session: 'anthropic',
  // 'openai' or 'gemini' (the `inboundType` of the surface it arrived
  // on — see src/llms/inbound/surfaces.ts). Set once on the first
  // request that carries an inboundType and never overwritten, so a
  // subsequent OpenAI-compat request that happens to reuse a Claude Code
  // session id (rare, but possible) does not silently flip the tag. Null
  // for pre-migration sessions. Deliberately a plain nullable TEXT and
  // not a Postgres enum: the set of wire formats grows with the surface
  // registry, and an enum would make each new one a DDL migration and a
  // deploy-order hazard for no read-side benefit.
  inboundType String?
  logs        RequestLog[]
  messages    Message[]
}

// One row per chat turn. Populated by the pipeline: on request send it
// appends the last user block; on response completion it appends the
// assembled assistant blocks (text / tool_use). Skips system prompt and
// tools — those repeat across turns and would dominate storage without
// helping the chat view.
model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   Json
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// Per-LLM-request stats: one row per upstream call that reaches the provider.
// Stored for the History view (model, tokens, cost, cache).
// No message content is ever stored here.
// A credential a client presents to /v1/*.
//
// Replaces the single envelope APIKEY for machine traffic. The plaintext
// is shown once at issue time and never stored — only its sha256 — so a
// database read cannot hand out working credentials. `prefix` is the
// visible first characters, enough to tell two tokens apart in a list
// without being enough to use.
//
// Scoping is the reason this is a table rather than a longer key:
// `surface` pins a token to one inbound surface, and `profileKey` runs
// that client's traffic through a named preference chain — a CI token on
// cost-first while interactive traffic stays on the default.
model AccessToken {
  id           String    @id @default(cuid())
  name         String
  tokenHash    String    @unique
  prefix       String
  // InboundSurface ids this token may call. Empty = every surface.
  //
  // A list rather than a single id because one client legitimately speaks
  // more than one: Codex uses /v1/responses and /v1/chat/completions, so
  // pinning it to either meant the other 401'd and the only way out was
  // an unscoped token — which is the scoping turned off, not narrowed.
  surfaces     String[]
  // RouterPreferenceProfile.key this token's traffic routes through.
  // Null = the surface's own profile.
  profileKey   String?
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  // When the secret behind this row was last replaced. Null means it is
  // still the one issued at createdAt. Rotation keeps the row — the id,
  // the name, the scope and every RequestLog pointing at it — and swaps
  // only tokenHash/prefix, so createdAt stops being the age of the
  // current credential and this becomes the field that answers it.
  rotatedAt    DateTime?
  expiresAt    DateTime?
  // Set rather than deleted, so a revoked token's RequestLog rows keep
  // pointing at something that says who they belonged to.
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([revokedAt])
}

// Per-surface routing behaviour.
//
// One row per InboundSurface the operator has overridden; a surface with
// no row uses its descriptor's `defaultRoutingMode`, which keeps the
// pre-Rialto behaviour (messages routed, everything else passthrough)
// as the shipped default. `profileKey` selects which
// RouterPreferenceProfile the surface's chain comes from — null means
// the shared 'live' profile.
model InboundSurfaceConfig {
  id            String   @id @default(cuid())
  surface       String   @unique
  routingMode   String
  profileKey    String?
  // `provider,model` pairs a caller may NOT name on this surface while it
  // is in passthrough. A deny list rather than an allow list because
  // passthrough's rule today is "anything enabled is nameable": an empty
  // array is exactly that behaviour, so this column is a no-op on every
  // existing install and a model added to a provider later stays
  // reachable without anyone editing a list.
  //
  // Distinct from `Model.enabled`, which is whether the provider serves
  // the model at all — that one is shared by every surface and every
  // chain. This is per surface, and only consulted in passthrough: in
  // routed mode the caller's string is a hint the chain overrides, so
  // there is nothing to deny.
  deniedTargets String[] @default([])
  updatedAt     DateTime @updatedAt
}

model RequestLog {
  id                 String   @id @default(cuid())
  sessionId          String
  session            Session  @relation(fields: [sessionId], references: [id])
  provider           String
  model              String
  // What the client (Claude Code) asked for in body.model BEFORE routing
  // rewrote it, and the route it took: the requested tier whose tier-map
  // routes served it (fable / opus / sonnet / haiku / other), or
  // "passthrough". The column keeps its old name; rows from before the
  // tier map carry the scenario the retired classifier chose. Both null
  // for rows written before this landed (backfill is not possible — the
  // original request is gone), so readers treat null as "untracked".
  // `model`/`provider` above stay the actual upstream target.
  requestedModel     String?
  scenario           String?
  // Whether the request carried a <RIALTO-SUBAGENT-MODEL> tag. It selects
  // nothing any more — the tier map has no subagent lane — but is still
  // recorded so Activity can tell the two apart. Null for rows written
  // before this column landed (untracked); true / false thereafter. Kept nullable so a reader
  // can distinguish "no data" from "data says agent".
  isSubagent         Boolean?
  // Which wire format the client came in on: 'anthropic' for
  // /v1/messages (Claude Code), 'openai' for /v1/chat/completions and
  // /v1/responses, 'gemini' for /v1beta/models/*. Null for rows written
  // before this landed (untracked). Persisted so the History view can
  // filter by inbound type without re-parsing anything from the payload.
  // Nullable TEXT rather than an enum, for the reason on Session above.
  inboundType        String?
  // Which inbound surface the request arrived on, as an
  // `InboundSurface.id` slug (see src/llms/inbound/surfaces.ts). Finer
  // than `inboundType`: /v1/chat/completions and /v1/responses are both
  // 'openai' but are separate surfaces with independent routing modes,
  // and Overview / Activity break traffic down per surface. Null on rows
  // written before this landed (untracked, not backfillable).
  surface            String?
  // Which AccessToken served the request, when one did. Null for rows
  // written before tokens existed, and for traffic on the since-removed
  // envelope bootstrap token. Not a foreign key: a token may be
  // deleted outright, and losing the attribution is worse than keeping
  // a dangling id that still tells you the requests came from one
  // client.
  accessTokenId      String?
  // Which subscription account served the request: the one the OAuth
  // transformer resolved for the attempt that succeeded. Null for
  // api_key providers and for rows written before this landed. Not a
  // foreign key, for the same reason as accessTokenId: an account can be
  // removed, and its history is still worth attributing to one account.
  subAccountId       String?
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  cacheReadTokens    Int      @default(0)
  cacheWriteTokens   Int      @default(0)
  // The part of cacheWriteTokens written with a 1-hour TTL — included in
  // it, not added. Priced at 2x input against 1.25x for the 5-minute
  // TTL; zero for vendors that do not split cache writes by TTL.
  cacheWrite1hTokens Int      @default(0)
  totalInputTokens   Int      @default(0)
  cacheHitPct        Int      @default(0)
  durationMs         Int      @default(0)
  status             Int      @default(200)
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([provider, model])
  @@index([surface, createdAt])
}

// Time series of subscription utilization, captured on an interval so
// the Usage view can chart the past week. `metric` is the window key
// (e.g. claude.five_hour, claude.seven_day, codex.primary). `percent`
// is 0-100. Old rows are pruned to keep this bounded.
model UsageSnapshot {
  id         String    @id @default(cuid())
  provider   String
  metric     String
  percent    Float
  resetAt    DateTime?
  capturedAt DateTime  @default(now())

  @@index([provider, metric, capturedAt])
  @@index([capturedAt])
}
